generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  currency      Int       @default(1000) // = STARTING_BITS (src/lib/onboarding.ts); OAuth sign-ups get this default
  lastDailyClaimAt DateTime?
  xp            Int       @default(0)
  level         Int       @default(1)
  rating        Int       @default(1000)
  inventory     Json      @default("[]")
  notifications Json      @default("[]")
  seenChangelogs Json     @default("[]")
  pendingRewards Json     @default("[]")
  fragments     Json      @default("{}")
  fragmentLogs  Json      @default("[]")
  wishlist      Json      @default("[]")
  bio               String?
  bannerImage       String?   @db.Text
  preferredLanguage String?
  hasSetupProfile Boolean @default(false)
  // One-time reward for connecting GitHub (BITS + the player's own Signature card)
  githubBonusGranted Boolean @default(false)
  // One-time reward for sharing a card or profile link (SHARE_BONUS)
  shareBonusGranted  Boolean @default(false)
  // Referral: the player whose invite link this account signed up with (set once, new players only),
  // and whether the referral BITS were paid (when this account connected GitHub)
  referredById       String?
  referralRewardPaid Boolean @default(false)
  // Last time the player swapped one of their daily missions (1 swap per UTC day)
  missionRerollAt    DateTime?
  // Ranked season (seasons.ts): best rating reached this season and PvP battles played in it
  seasonPeakRating   Int      @default(1000)
  seasonBattles      Int      @default(0)
  // Consecutive daily-reward claims (resets when a day is skipped); drives the 7-day login calendar
  loginStreak        Int      @default(0)
  // Packs opened since the last Legendary card (pity counter)
  packsSinceLegendary Int     @default(0)
  // New-player onboarding (starter pack, welcome screen, "Getting started" checklist); null for players from before it existed
  onboarding         Json?
  // Equipped profile cosmetics (collections.ts): a title id and an avatar frame id, checked against unlocks when set
  title              String?
  frame              String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  cards         UserCard[]
  missions      UserMission[]
  friendships   Friendship[]    @relation("UserFriendships")
  friendRequests Friendship[]   @relation("FriendRequests")
  battlesAsChallenger Battle[] @relation("Challenger")
  battlesAsDefender   Battle[] @relation("Defender")
  achievements        UserAchievement[]
  bitsTransactions    BitsTransaction[]
  seasonResults       SeasonResult[]
  towerRuns           TowerRun[]
  sprintResults       SprintResult[]
  giftsSent           CardGift[]      @relation("GiftsSent")
  giftsReceived       CardGift[]      @relation("GiftsReceived")
  tradesProposed      CardTrade[]     @relation("TradesProposed")
  tradesReceived      CardTrade[]     @relation("TradesReceived")
  leagueLineups       LeagueLineup[]

  @@index([referredById])
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Card {
  id             String   @id @default(uuid())
  githubUsername String   @unique
  avatarUrl      String?
  name           String
  flavorText     String
  atk            Int
  def            Int
  hp             Int
  rarity         String
  primaryLanguage String?
  createdAt      DateTime @default(now())

  // GitHub profile snapshot behind the card title (cardVisuals.ts); null on cards not refreshed since
  followers       Int?
  totalStars      Int?
  totalForks      Int?
  topRepoStars    Int?
  publicRepos     Int?
  publicGists     Int?
  languageCount   Int?
  githubCreatedAt DateTime?
  profileUpdatedAt DateTime?

  owners         UserCard[]
  gifts          CardGift[]
  leaguePrices   LeaguePrice[]
  leagueScores   LeagueDevScore[]
  battlesAsChallenger Battle[] @relation("ChallengerCard")
  battlesAsDefender   Battle[] @relation("DefenderCard")

  // Fallback draws, Sprints and the Dev of the Week filter by these
  @@index([rarity, primaryLanguage])
  @@index([primaryLanguage])
}

model UserCard {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  card      Card     @relation(fields: [cardId], references: [id])
  cardId    String
  quantity  Int      @default(1)
  shards    Int      @default(0)
  isShiny   Boolean  @default(false)
  // "standard" (boosters, forge) or "signature": the player's own card, granted only by connecting GitHub
  edition   String   @default("standard")
  stamina   Int      @default(100)
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  inActiveTeam Boolean @default(false) @map("in_active_team")
  loyaltyCount      Int      @default(0)
  loyaltyTier       String   @default("none")
  loyaltyMilestones Json     @default("[]")
  lifetimeStats     Json     @default("{}")
  // Training level bought with BITS + fragments (training.ts): +2% ATK/DEF/HP per level in battle
  trainingLevel     Int      @default(0)
  showcaseOrder     Int?
  createdAt DateTime @default(now())

  // A player owns each developer once (extra pulls become fragments)
  @@unique([userId, cardId])
  @@index([userId])
}

model Mission {
  id          String   @id @default(uuid())
  description String
  reward      Int
  type        String
  targetValue String?
  createdAt   DateTime @default(now())

  userMissions UserMission[]
}

model UserMission {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  mission   Mission  @relation(fields: [missionId], references: [id])
  missionId String
  progress  Int      @default(0)
  completed Boolean  @default(false)
  // "daily" (3 a day), "weekly" (2 a week) or "dev" (1 a day of real GitHub activity)
  period    String   @default("daily")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Battle {
  // Friend challenges: BITS each player puts in (winner takes both) and whether
  // anyone with the link may accept it (defenderId set when someone does)
  stake            Int           @default(0)
  isOpen           Boolean       @default(false)
  id               String        @id @default(uuid())
  challengerId     String
  defenderId       String?
  challengerCardId String?
  defenderCardId   String?
  challengerTeam   Json?
  defenderTeam     Json?
  log              Json?
  status           String        @default("PENDING")
  winnerId         String?
  rewardBits       Int           @default(0)
  isRandom         Boolean       @default(false)
  leagueMode       String        @default("OPEN")
  battleStats      Json?
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  challenger       User          @relation("Challenger", fields: [challengerId], references: [id])
  defender         User?         @relation("Defender", fields: [defenderId], references: [id])
  challengerCard   Card?         @relation("ChallengerCard", fields: [challengerCardId], references: [id])
  defenderCard     Card?         @relation("DefenderCard", fields: [defenderCardId], references: [id])
  rounds           BattleRound[]

  // History, pending challenges, win counts and challenge expiry
  @@index([challengerId, status])
  @@index([defenderId, status])
  @@index([winnerId])
  @@index([status, expiresAt])
}

model BattleRound {
  id              String  @id @default(uuid())
  battleId        String
  roundNum        Int
  attribute       String
  challengerValue Int
  defenderValue   Int
  winnerId        String?

  battle          Battle  @relation(fields: [battleId], references: [id], onDelete: Cascade)
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("PENDING") // PENDING, ACCEPTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendRequests", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  // Incoming requests and friend lists (the unique index covers userId)
  @@index([friendId, status])
}

model ChangelogEntry {
  id        String   @id @default(uuid())
  version   String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Legacy fallback pool, no longer used (replaced by BoosterReserve); drop in a later migration
model BoosterFallbackDev {
  id              String   @id @default(uuid())
  packId          String
  githubUsername   String
  avatarUrl       String?
  name            String
  flavorText      String   @default("")
  atk             Int      @default(10)
  def             Int      @default(10)
  hp              Int      @default(50)
  rarity          String
  primaryLanguage String?
  topLanguages    Json     @default("[]")
  createdAt       DateTime @default(now())

  @@unique([packId, githubUsername])
  @@index([packId, rarity])
}

// Consumable reserve of pre-drawn developers per booster and rarity slot. Every row is an
// independent uniform draw and is used exactly once (oldest first), so boosters served from
// the reserve are as random as live draws — just instant and immune to GitHub rate limits.
model BoosterReserve {
  id             String   @id @default(uuid())
  packId         String
  rarity         String   // follower band of the slot it was drawn for
  githubUsername String
  stats          Json     // DevStats at draw time
  createdAt      DateTime @default(now())

  @@index([packId, rarity, createdAt])
}

// ─── Booster sampler state ──────────────────────────────────────────────

// Key/value cache for the GitHub sampler: search counts, id→signup-time anchors, max account id
model GithubCache {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}

// Public members of GitHub organizations (pool of the Big Tech booster)
model OrgMember {
  org       String
  login     String
  followers Int
  updatedAt DateTime @default(now()) @updatedAt

  @@id([org, login])
  @@index([org, followers])
}

// Developers a player pulled recently from each booster type (avoids back-to-back repeats)
model RecentPull {
  id             String   @id @default(uuid())
  userId         String
  packId         String
  githubUsername String
  createdAt      DateTime @default(now())

  @@index([userId, packId, createdAt])
  @@index([createdAt])
}

// Fixed-window request counters for rate limiting (key = action + client), shared by all instances
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Achievement tiers a player has unlocked (bronze = 1, silver = 2, gold = 3); rewards are paid once per tier
model UserAchievement {
  userId        String
  achievementId String
  tier          Int
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId, tier])
}

// A free booster opened by a visitor without an account (landing page). The
// cards go to the account created afterwards with the cookie holding `id`.
model GuestPull {
  id          String    @id @default(uuid())
  cardIds     String[]
  createdAt   DateTime  @default(now())
  claimedById String?
  claimedAt   DateTime?

  @@index([createdAt])
}

// Every change to a player's BITS (append-only), written in the same transaction
// as the balance change (src/lib/bitsLedger.ts). Amount is signed.
// A card one player gave to a friend (giftService.ts): for the daily limits and
// so the friends' feed doesn't show the gift as a pull
model CardGift {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  cardId     String
  isShiny    Boolean  @default(false)
  // BITS the sender paid (gone from the game)
  fee        Int
  createdAt  DateTime @default(now())

  sender   User @relation("GiftsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("GiftsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  card     Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

// A card swap between two friends (tradeService.ts): the proposer offers some of
// their cards for some of the receiver's. Nothing is reserved while it waits;
// everything is checked again when the receiver accepts.
model CardTrade {
  id               String    @id @default(uuid())
  proposerId       String
  receiverId       String
  // Card ids (Card.id): what the proposer gives, and what they ask for in return
  offeredCardIds   String[]
  requestedCardIds String[]
  // PENDING, then ACCEPTED, DECLINED, CANCELLED (by the proposer) or EXPIRED
  status           String    @default("PENDING")
  // BITS each side paid on acceptance (gone from the game)
  proposerFee      Int       @default(0)
  receiverFee      Int       @default(0)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  respondedAt      DateTime?

  proposer User @relation("TradesProposed", fields: [proposerId], references: [id], onDelete: Cascade)
  receiver User @relation("TradesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([proposerId, status])
  @@index([receiverId, status])
}

// ─── Dev League (Cartola-style, league.ts / leagueService.ts) ────────────────

// One week of the Dev League, Monday 00:00 to Monday 00:00 UTC. id = the Monday ("2026-10-19").
model LeagueRound {
  id       String    @id
  startsAt DateTime
  endsAt   DateTime
  // Set once the final scores are in and the prizes paid
  closedAt DateTime?

  prices  LeaguePrice[]
  scores  LeagueDevScore[]
  lineups LeagueLineup[]

  @@index([closedAt, endsAt])
}

// What a developer costs (C$) in a round, from the form of the weeks before.
// price 0: GitHub no longer knows the account, so the developer is off the market.
model LeaguePrice {
  roundId String
  cardId  String
  price   Int
  // Average weekly points over the form window
  form    Int

  round LeagueRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  card  Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([roundId, cardId])
}

// A developer's points in a round and the counts behind them (updated daily while it runs).
model LeagueDevScore {
  roundId      String
  cardId       String
  points       Int      @default(0)
  commits      Int      @default(0)
  pullRequests Int      @default(0)
  reviews      Int      @default(0)
  issues       Int      @default(0)
  activeDays   Int      @default(0)
  // The GitHub account no longer answers: 0 points
  missing      Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  round LeagueRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  card  Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([roundId, cardId])
  @@index([roundId, updatedAt])
}

// A player's five developers for a round. Editable until the round starts.
model LeagueLineup {
  roundId    String
  userId     String
  // Card ids (Card.id), 5 different developers
  cardIds    String[]
  captainId  String
  // C$ at the round's prices when saved
  cost       Int
  // With the captain and the collection bonus; final when the round closes
  points     Int      @default(0)
  position   Int?
  rewardBits Int      @default(0)
  updatedAt  DateTime @updatedAt

  round LeagueRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roundId, userId])
  @@index([roundId, points])
}

model BitsTransaction {
  id           String   @id @default(uuid())
  userId       String
  amount       Int
  balanceAfter Int
  reason       String
  detail       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A ranked season (a calendar month, UTC). The open one has closedAt = null.
model Season {
  id        Int       @id
  startsAt  DateTime
  endsAt    DateTime
  closedAt  DateTime?

  results SeasonResult[]
}

// Where a player finished a season (only players with at least one PvP battle in it).
model SeasonResult {
  id          String   @id @default(uuid())
  seasonId    Int
  userId      String
  finalRating Int
  peakRating  Int
  tier        String
  rewardBits  Int
  battles     Int
  createdAt   DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([userId])
}

// A player's climb of the Tower in one week (tower.ts): floors cleared and attempts.
model TowerRun {
  id        String   @id @default(uuid())
  userId    String
  weekStart DateTime
  cleared   Int      @default(0)
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart, cleared])
}

// The opponents of one Tower floor for one week: fixed once drawn, the same for everyone.
model TowerFloorTeam {
  weekStart DateTime
  floor     Int
  theme     String
  cardIds   String[]

  @@id([weekStart, floor])
}

// A daily or weekly Sprint (sprints.ts): its theme is fixed when the row is created; closedAt once paid.
model Sprint {
  id       String    @id // "daily:2026-10-13", "weekly:2026-10-12"
  kind     String
  theme    String
  startsAt DateTime
  endsAt   DateTime
  closedAt DateTime?
  // Weekly only: githubUsername of the Dev of the Week, cheaper at the Forge (weeklyEvents.ts)
  featuredDev String?

  results SprintResult[]

  @@index([closedAt, endsAt])
}

// Where a player finished a closed Sprint (the top SPRINT_RESULTS_KEPT) and what it paid.
model SprintResult {
  sprintId   String
  userId     String
  position   Int
  score      Int
  rewardBits Int      @default(0)
  createdAt  DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sprintId, userId])
  @@index([userId])
}
