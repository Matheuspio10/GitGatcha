# Copy to .env.local and fill in. Never commit real values.
# Use a Neon *development* branch here, not the production database.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Server token for the GitHub API (public read-only; no scopes needed)
GITHUB_TOKEN=""

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# OAuth providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Protects /api/cron/rebuild-fallback-pool (required in production)
CRON_SECRET=""
